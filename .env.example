# Copy to .env (local dev) and fill in. Production values go in
# Vercel → Project → Settings → Environment Variables.

# Database — local dev uses SQLite; production uses the Supabase pooler URL
DATABASE_URL="file:./dev.db"
# DIRECT_URL=            # production only (Supabase session pooler, for migrations)

# Supabase (production storage for annotation frames; hosted app only)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# Bunny Stream — video hosting with no size cap
# From: dash.bunny.net → Stream → CJC Animation Portal → API tab
BUNNY_STREAM_LIBRARY_ID="718455"
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOST=          # e.g. vz-xxxxxxxx-xxx.b-cdn.net

# Bootstrap admin (optional): auto-created as admin on first login attempt if
# missing; existing accounts are never overwritten. Min 8-char password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# YouTube scheduling for the children's channel — see SETUP-YOUTUBE.md
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Claude "Make prompt" (optional; template fallback without it)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
