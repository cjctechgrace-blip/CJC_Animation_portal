// CJC Animation Portal — data model
// Local dev uses SQLite. Supabase/Postgres variant lives in schema.postgres.prisma.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member") // "admin" | "member"
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions       Session[]
  projects       Project[]
  episodes       Episode[]
  scenes         Scene[]
  comments       Comment[]
  posts          Post[]
  postVotes      PostVote[]
  edits          Edit[]
  invitesCreated Invite[]
  approvals      EpisodeApproval[]
  visits         EpisodeVisit[]
  sceneVersions  SceneVersion[]
}

// One-time links: invite a new teammate (they pick their own password) or let
// an existing member reset theirs. Tokens are single-use and expire.
model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String    @default("")
  role        String    @default("member") // "admin" | "member"
  kind        String    @default("invite") // "invite" | "reset"
  token       String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  episodes Episode[]

  @@index([createdById])
}

model Episode {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  // publishing pipeline (Kanban board): review → approved → scheduled → published
  status         String    @default("review")
  publishAt      DateTime?
  youtubeVideoId String?
  reviewRound    Int       @default(1)
  archivedAt     DateTime?

  scenes    Scene[]
  posts     Post[]
  approvals EpisodeApproval[]
  visits    EpisodeVisit[]

  @@index([projectId])
  @@index([status])
}

// A reviewer's personal sign-off on an episode ("looks good to me").
model EpisodeApproval {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([episodeId, userId])
  @@index([episodeId])
}

// Who has opened an episode (for the "N viewed" count).
model EpisodeVisit {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastAt    DateTime @default(now())

  @@unique([episodeId, userId])
  @@index([episodeId])
}

// A scene is one short clip (often a single AI generation). Episodes are made of
// ordered scenes; feedback is left per scene.
model Scene {
  id          String   @id @default(cuid())
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title       String
  order       Int      @default(0)
  // storage id (Supabase Storage key in prod, local filename in dev)
  videoFile   String?
  mimeType    String?
  durationMs  Int?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  comments Comment[]
  edits    Edit[]
  versions SceneVersion[]

  @@index([episodeId])
}
// Prior clips of a scene, kept for before/after comparison. The scene's
// current clip lives on Scene.videoFile; each replacement pushes the old one
// here as "Original" / "Improvement N".
model SceneVersion {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  versionNo   Int      // 0 = Original, 1 = Improvement 1, ...
  videoFile   String
  mimeType    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([sceneId, versionNo])
  @@index([sceneId])
}


// A non-destructive edit "recipe" for a scene: an ordered list of trimmed
// segments (which may pull from other scenes = merge). Stored as JSON; plays
// the original clips live, never rendered to a new file.
model Edit {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  name        String
  data        String   @default("{\"segments\":[]}")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([sceneId])
}

model Comment {
  id         String   @id @default(cuid())
  sceneId    String
  scene      Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  // pinned point in the clip, in milliseconds. Null for a reply.
  timecodeMs Int?
  // annotated frame grabbed at the pinned moment. Doubles as the AI start-frame.
  frameImage String?
  // cached Higgsfield-format prompt generated by Claude from this note + frame.
  generatedPrompt String?
  // region/spot marker on the frame, as JSON {type,x,y,w,h} normalized 0..1.
  mark       String?
  // reviewer's 1-5 "how big a deal is this?" score. Null = not rated.
  priority   Int?
  parentId   String?
  parent     Comment? @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Thread")
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  postRefs   PostRef[]

  @@index([sceneId])
  @@index([parentId])
}

// Episode-level discussion (forum/Reddit-style): threaded posts, votes, and
// references to scene annotations (Comments).
model Post {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  parentId  String?
  parent    Post?    @relation("PostThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]   @relation("PostThread")
  createdAt DateTime @default(now())

  votes PostVote[]
  refs  PostRef[]

  @@index([episodeId])
  @@index([parentId])
}

model PostVote {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostRef {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([postId, commentId])
  @@index([postId])
}
