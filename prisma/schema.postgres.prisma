// Postgres (Supabase) variant — models identical to schema.prisma.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("member")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  sessions       Session[]
  projects       Project[]
  episodes       Episode[]
  scenes         Scene[]
  comments       Comment[]
  posts          Post[]
  postVotes      PostVote[]
  edits          Edit[]
  invitesCreated Invite[]
  approvals      EpisodeApproval[]
  visits         EpisodeVisit[]
  sceneVersions  SceneVersion[]
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  name        String    @default("")
  role        String    @default("member")
  kind        String    @default("invite")
  token       String    @unique
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  episodes Episode[]

  @@index([createdById])
}

model Episode {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  status         String    @default("review")
  publishAt      DateTime?
  youtubeVideoId String?
  reviewRound    Int       @default(1)
  archivedAt     DateTime?

  scenes    Scene[]
  posts     Post[]
  approvals EpisodeApproval[]
  visits    EpisodeVisit[]

  @@index([projectId])
  @@index([status])
}

model EpisodeApproval {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([episodeId, userId])
  @@index([episodeId])
}

model EpisodeVisit {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastAt    DateTime @default(now())

  @@unique([episodeId, userId])
  @@index([episodeId])
}

model Scene {
  id          String   @id @default(cuid())
  episodeId   String
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  title       String
  order       Int      @default(0)
  videoFile   String?
  mimeType    String?
  durationMs  Int?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  comments Comment[]
  edits    Edit[]
  versions SceneVersion[]

  @@index([episodeId])
}
// Prior clips of a scene, kept for before/after comparison. The scene's
// current clip lives on Scene.videoFile; each replacement pushes the old one
// here as "Original" / "Improvement N".
model SceneVersion {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  versionNo   Int      // 0 = Original, 1 = Improvement 1, ...
  videoFile   String
  mimeType    String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([sceneId, versionNo])
  @@index([sceneId])
}


model Edit {
  id          String   @id @default(cuid())
  sceneId     String
  scene       Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  name        String
  data        String   @default("{\"segments\":[]}")
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([sceneId])
}

model Comment {
  id         String   @id @default(cuid())
  sceneId    String
  scene      Scene    @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  timecodeMs Int?
  frameImage String?
  generatedPrompt String?
  mark       String?
  parentId   String?
  parent     Comment? @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("Thread")
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  postRefs   PostRef[]

  @@index([sceneId])
  @@index([parentId])
}

model Post {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  parentId  String?
  parent    Post?    @relation("PostThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Post[]   @relation("PostThread")
  createdAt DateTime @default(now())

  votes PostVote[]
  refs  PostRef[]

  @@index([episodeId])
  @@index([parentId])
}

model PostVote {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
}

model PostRef {
  id        String  @id @default(cuid())
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([postId, commentId])
  @@index([postId])
}
